# Local development secrets — copy to .dev.vars (git-ignored). In production use: npx wrangler secret put <NAME>
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_ACCOUNT_ID=
# PAYHERO_CHANNEL_ID=   (optional — leave unset so payments settle to the payments wallet)

PAYHERO_CALLBACK_SECRET=a-long-random-string
ADMIN_PASSWORD=
# ALLOW_SAMPLE_FIXTURES=true   # only for demos: lets the built-in sample fixtures be paid for
